# Tensor backend environment — copy to .env and fill in when ready.

ENVIRONMENT=development

# PostgreSQL (SQLAlchemy). Optional until the data model is wired up.
# Same database as the frontend, but a different set of tables: Alembic owns
# the domain, RBAC and audit; Better Auth owns user/session/account/
# verification/jwks and is migrated separately from the frontend repo.
#
# Port 5434, NOT 5432 - this machine already runs other projects' Postgres on
# 5432/5433/5544. `docker compose up -d` from the repo root starts it.
DATABASE_URL=postgresql+psycopg://tensor:tensor_local_dev@localhost:5434/tensor

# --- Verifying access tokens -----------------------------------------------
# The frontend is the identity provider. It signs tokens with a key we never
# hold; we fetch the public half from its JWKS endpoint.
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks

# Must equal the frontend's BETTER_AUTH_URL EXACTLY. Verified as the `iss`
# claim, so a token minted by a different issuer - or the same app on a
# different port - is rejected even when well-formed.
AUTH_ISSUER=http://localhost:3001

# Verified as the `aud` claim. A token minted for another service is rejected
# here even when its signature is perfectly valid. Defaults to "tensor-core".
# AUTH_AUDIENCE=tensor-core

# --- Internal API ----------------------------------------------------------
# Shared secret for the frontend's server-to-server role lookup
# (GET /internal/users/{id}/authz), which Better Auth calls when minting a
# token. Must match INTERNAL_API_SECRET in Tensor/.env.
# Unset means the internal API is CLOSED (503), not open. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# INTERNAL_API_SECRET=

# Comma-separated CORS origins (the frontend).
CORS_ORIGINS=["http://localhost:3001"]
