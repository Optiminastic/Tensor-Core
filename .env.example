# Tensor-Core (Go) environment - copy to .env and fill in.

ENVIRONMENT=development

# Port the API listens on. Not a default: 8000 is taken by another project.
PORT=8001

# PostgreSQL DSN (pgx). Same database as the frontend, different tables: goose
# owns the domain/RBAC/audit tables, Better Auth owns user/session/account/
# verification/jwks (migrated from the frontend).
#
# Port 5434, NOT 5432 - this machine runs other projects' Postgres on
# 5432/5433/5544. A SQLAlchemy-style "+psycopg" driver suffix is stripped
# automatically, so a DSN shared with the Python era still works.
DATABASE_URL=postgresql://tensor:tensor_local_dev@localhost:5434/tensor?sslmode=disable

# --- Verifying access tokens -----------------------------------------------
# The frontend is the identity provider. We fetch the public keys from its JWKS.
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks

# Must equal the frontend's BETTER_AUTH_URL EXACTLY (verified as the `iss`
# claim). A port mismatch rejects every token with "unexpected issuer".
AUTH_ISSUER=http://localhost:3001

# Verified as the `aud` claim. Defaults to "tensor-core".
# AUTH_AUDIENCE=tensor-core

# How long JWKS keys are cached, in seconds. Defaults to 300.
# JWKS_CACHE_SECONDS=300

# --- Internal API ----------------------------------------------------------
# Shared secret for the frontend's server-to-server role lookup
# (GET /internal/users/{id}/authz), called when minting a token. Must match
# INTERNAL_API_SECRET in Tensor/.env. Unset means the internal API is CLOSED
# (503), not open. Generate with:
#   openssl rand -base64 32
# INTERNAL_API_SECRET=

# Comma-separated or JSON-array CORS origins (the frontend).
CORS_ORIGINS=["http://localhost:3001"]

# ---------------------------------------------------------------------------
# The win-back scheduler (cmd/winbackworker, its own deployment)
# ---------------------------------------------------------------------------
# BOTH SWITCHES DEFAULT TO FALSE, and that is consent rather than
# configuration. With them off the sweep still runs every rule and logs who it
# WOULD have reached - which is how the rules get checked against a real store
# before anybody is contacted. They are separate because a call interrupts
# somebody and a message waits for them.
WINBACK_CALLS_ENABLED=false
WINBACK_WHATSAPP_ENABLED=false
# How long a checkout must have been abandoned before it is contacted. Too
# soon and you reach somebody still typing their card number.
WINBACK_CALL_DELAY_MINUTES=10
# A basket left three weeks ago is not a win-back, it is a cold call.
WINBACK_CALL_MAX_AGE_HOURS=24
WINBACK_CALL_INTERVAL_MINUTES=5
# Per channel. A burst from one tick is how a telephony account gets flagged.
WINBACK_CALL_MAX_PER_RUN=5
WINBACK_WHATSAPP_MAX_PER_RUN=10
# THE TESTING GATE. While non-empty, NOTHING else is contacted whatever the
# rules allow - so the scheduler can be pointed at the live store with one
# real checkout. Empty is the production setting.
WINBACK_CALL_ONLY=
# The host baked into the approved WhatsApp template's URL button. Shopify's
# recovery links must be on it, or Tensor refuses to send rather than point
# the button at the wrong shop.
WINBACK_LINK_HOST=
# The SECOND URL button ("Shop more gifts"). A path, not a URL - the template
# bakes in the host. It cannot be empty while that button is dynamic: Meta
# refuses an empty parameter and a missing one refuses the WHOLE message, so
# the bare homepage is spelled "#".
WINBACK_SHOP_PATH=#

# Sarvam Voice Agents (the call half). A VOICE AGENTS key, not a model-API key.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_ID=
# An integer, and a COMMITTED version. A draft does not run.
SARVAM_AGENT_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_PRODUCT_VARIABLE=cart_item_name

# WhatsApp Business, Meta Cloud API (the message half).
# A SYSTEM USER token. A user token works identically for an hour and then
# stops, which is the worst failure shape for a thing that messages customers.
WHATSAPP_ACCESS_TOKEN=
# The NUMBER's id, not the business account's - the WABA id there answers 404.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_ID=
# Only needed to verify inbound webhooks; sending works without it.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0
# "en", not "en_US" - they are different templates to Meta, and the wrong one
# answers "Template name does not exist in the translation".
WHATSAPP_TEMPLATE_NAME=cart_recovery_personalised
WHATSAPP_TEMPLATE_LANGUAGE=en

# Delhivery (the Deliveries page). READ-ONLY: Tensor only tracks shipments.
DELHIVERY_API_KEY=
# Blank means production (track.delhivery.com).
DELHIVERY_BASE_URL=
