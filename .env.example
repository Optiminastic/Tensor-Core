# Tensor backend environment — copy to .env and fill in when ready.

ENVIRONMENT=development

# PostgreSQL (SQLAlchemy). Optional until the data model is wired up.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tensor

# Better Auth JWKS endpoint (frontend) for verifying JWTs.
# AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Comma-separated CORS origins (the frontend). Defaults to localhost:3000.
# CORS_ORIGINS=["http://localhost:3000"]
